# Copy to .env and paste your free key from https://nexwall.kodnextech.com/developers/register
# WARNING: EXPO_PUBLIC_* values are embedded in the app bundle. Use a backend proxy in production.
EXPO_PUBLIC_NEXWALL_API_KEY=paste_your_free_key_here

# Optional: point the app at your own proxy instead of the NexWall API
# EXPO_PUBLIC_NEXWALL_BASE_URL=https://your-proxy.example.com/nexwall
